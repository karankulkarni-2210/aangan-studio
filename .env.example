# Aangan Studio backend. Copy to .env.local. NEVER commit real values.
# Demo mode: missing provider credentials select explicit MOCK adapters (labelled simulated).
# Live mode: fails closed until security configuration is complete (see /ready).
APP_MODE=demo
# Alias accepted: NEXT_PUBLIC_APP_URL
APP_BASE_URL=http://localhost:3000
# Frontend lead page used in handoff emails (authenticated). {lead_id} is substituted.
LEAD_URL_TEMPLATE=http://localhost:3000/leads/{lead_id}

# --- Supabase (Postgres + Auth) ---
# Local CLI default: postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Vercel: use the transaction pooler (port 6543) and DATABASE_SSL=true.
DATABASE_URL=
DATABASE_SSL=false
DATABASE_POOL_MAX=3
# JWT verification: JWKS from SUPABASE_URL (asymmetric keys) and/or the legacy HS256 secret.
# Alias accepted: NEXT_PUBLIC_SUPABASE_URL (the frontend also uses NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY)
SUPABASE_URL=
SUPABASE_JWT_SECRET=
# The service-role key is NOT used by this app and must never reach the browser.

# --- Server-to-server secrets (>= 32 random chars; `npm run demo:secrets` creates local ones) ---
VOICE_TOOL_SECRET=
DISPATCH_SECRET=
# Vercel Cron sends Authorization: Bearer $CRON_SECRET (accepted as an alias of DISPATCH_SECRET)
CRON_SECRET=
# Demo-only staff tokens (ignored when APP_MODE=live)
DEMO_JWT_SECRET=
SIMULATED_VOICE_WEBHOOK_SECRET=

# --- Vaani Labs (voice) ---
VAANI_API_KEY=
VAANI_WEBHOOK_SECRET=
VAANI_API_BASE_URL=https://www.vaanilabs.in
VAANI_FLOW_ID=

# --- Gemini Flash (classification/extraction) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_MS=8000

# --- Cal.com (consultations) ---
# Aliases accepted: CAL_API_KEY, CAL_EVENT_TYPE_ID (a numeric id or the event-type URL)
CALCOM_API_KEY=
CALCOM_EVENT_TYPE_ID=
CALCOM_API_BASE_URL=https://api.cal.com

# --- HubSpot (CRM) ---
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_PIPELINE_ID=
# Alias accepted: HUBSPOT_QUALIFIED_STAGE_ID (internal stage id, e.g. from GET /crm/v3/pipelines/deals/default/stages)
HUBSPOT_DEALSTAGE_ID=
HUBSPOT_LEAD_ID_PROPERTY=aangan_lead_id

# --- Resend (designer handoff email) ---
# Alias accepted: RESEND_FROM_EMAIL. onboarding@resend.dev only delivers to the Resend account owner.
RESEND_API_KEY=
RESEND_FROM=
# Pilot redirect: every LIVE handoff email goes to this address and names the intended recipient.
DESIGNER_HANDOFF_EMAIL=

LOG_LEVEL=info
