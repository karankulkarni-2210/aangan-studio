{
  "name": "aangan-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Aangan Studio phone-enquiry MVP backend (simulated by default; demo data and sample business rules)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "tsx --tsconfig tsx.tsconfig.json scripts/demo.ts",
    "openapi": "tsx --tsconfig tsx.tsconfig.json scripts/generate-openapi.ts",
    "seed:generate": "tsx --tsconfig tsx.tsconfig.json scripts/generate-seed.ts",
    "db:migrate": "tsx --tsconfig tsx.tsconfig.json scripts/migrate.ts",
    "demo:secrets": "tsx --tsconfig tsx.tsconfig.json scripts/demo-secrets.ts",
    "demo:token": "tsx --tsconfig tsx.tsconfig.json scripts/demo-token.ts",
    "check": "npm run typecheck && npm test && npm run demo",
    "bridge": "tsx --tsconfig tsx.tsconfig.json scripts/bridge.ts",
    "policy:publish": "tsx --tsconfig tsx.tsconfig.json scripts/publish-policy.ts"
  },
  "dependencies": {
    "jose": "^6.2.12",
    "livekit-client": "^2.22.4",
    "next": "^16.4.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.9"
  }
}
